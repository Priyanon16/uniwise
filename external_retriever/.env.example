# ============================================================
# MBS UniWise AI External Retriever
# Copy this file to .env and fill in your own keys.
# NEVER upload/share .env.
# ============================================================

EXTERNAL_KB_API_KEY=CHANGE_ME_TO_RANDOM_SECRET
EXTERNAL_KNOWLEDGE_ID=mbs-academic-guide-v1

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
COHERE_API_KEY=YOUR_COHERE_API_KEY

SEGMENTS_CSV=dify_segments.csv

OPENAI_EMBED_MODEL=text-embedding-3-small
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# Current corpus has 6 chunks, matching the ablation experiment.
CANDIDATE_K=6
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

RETRIEVER_CACHE_DIR=.retriever_cache
