# MBS External Retriever - ReadyIDC
# Copy to .env and fill your real values. Never commit/share .env.

EXTERNAL_KB_API_KEY=CHANGE_ME_TO_RANDOM_SECRET
EXTERNAL_KNOWLEDGE_ID=mbs-academic-guide-v1
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
COHERE_API_KEY=YOUR_COHERE_API_KEY

SEGMENTS_CSV=/app/data/dify_segments.csv
AUTO_RELOAD_SECONDS=2
OPENAI_EMBED_MODEL=text-embedding-3-small
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
CANDIDATE_K=6
RRF_K=60
BM25_K1=1.5
BM25_B=0.75
RETRIEVER_CACHE_DIR=/app/.retriever_cache

# Fill this after Dify is running. Example only; inspect your real Dify network name.
DIFY_NETWORK=CHANGE_ME_TO_DIFY_DOCKER_NETWORK
